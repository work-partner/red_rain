{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"esModuleInterop": true,
		"removeComments": false,
		"preserveConstEnums": true,
		"sourceMap": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"isolatedModules": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types": [
			"@webgpu/types",
			"mocha",
			"semver",
			"sinon",
			"trusted-types",
			"winreg",
			"wicg-file-system-access"
		]
	},
	"include": [
		"./typings",
		"./vs/base/**/*.ts",
		"./vs/platform/**/*.ts",
		"./vs/editor/contrib/redrain/**/*.ts",
		"./vs/editor/browser/**/*.ts",
		"./vs/editor/common/**/*.ts",
		"./vs/workbench/contrib/redrain/**/*.ts",
		"./vs/workbench/services/layout/**/*.ts",
		"./vs/workbench/services/statusbar/**/*.ts",
		"./vs/workbench/common/**/*.ts",
		"./vs/nls.ts",
		"./vscode-dts/vscode.proposed.*.d.ts",
		"./vscode-dts/vscode.d.ts"
	]
}
